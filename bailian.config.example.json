{
  "agent_runtime": "openai-compatible",
  "base_url": "${BAILIAN_BASE_URL}",
  "api_key_env": "DASHSCOPE_API_KEY",
  "agent_model": "${BAILIAN_MODEL}",
  "thinking_api": "enable_thinking",
  "thinking": true,
  "reasoning_effort": "medium",
  "supported_reasoning_efforts": ["low", "medium", "xhigh"],
  "stream": true,
  "include_usage": true,
  "max_context_tokens": 200000,
  "max_tokens": 24000,
  "max_concurrency": 3,
  "adaptive_concurrency": true,
  "semantic_max_attempts": 1,
  "max_repair_rounds": 2,
  "model_preflight": "auto",
  "timeout_seconds": 600,
  "max_retries": 0
}
