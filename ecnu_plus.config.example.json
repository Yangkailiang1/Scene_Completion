{
  "agent_runtime": "openai-compatible",
  "base_url": "${ECNU_MAX_BASE_URL}",
  "api_key_env": "ECNU_MAX_API_KEY",
  "agent_model": "ecnu-plus",
  "embedding_model": "${ECNU_EMBEDDING_TEXT}",
  "thinking": true,
  "stream": true,
  "reasoning_effort": "medium",
  "supported_reasoning_efforts": ["low", "medium", "xhigh"],
  "max_context_tokens": 200000,
  "max_tokens": 24000,
  "max_concurrency": 1,
  "max_retries": 2,
  "semantic_max_attempts": 1,
  "diagnosis_max_format_attempts": 2,
  "model_preflight": "auto",
  "adaptive_concurrency": true,
  "timeout_seconds": 600
}
