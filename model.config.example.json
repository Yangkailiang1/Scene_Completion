{
  "agent_runtime": "openai-compatible",
  "base_url": "${SCENE_API_BASE_URL}",
  "api_key_env": "SCENE_API_KEY",
  "agent_model": "${SCENE_AGENT_MODEL}",
  "embedding_model": "${SCENE_EMBEDDING_MODEL}",
  "thinking": false,
  "timeout_seconds": 600,
  "max_retries": 2,
  "semantic_max_attempts": 4,
  "max_tokens": 24000,
  "max_concurrency": 1,
  "model_preflight": "auto",
  "adaptive_concurrency": true
}
