{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "composition_type": {
            "enum": [
              "外部Actor（人类）",
              "外部Actor（系统）",
              "系统边界",
              "UI/前端",
              "内部服务",
              "用例",
              "内部数据库",
              "外部数据库",
              "内部资源",
              "外部资源",
              "连接设备",
              "部署硬件",
              "运行环境",
              "AI模型"
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_status": {
            "enum": [
              "explicit",
              "inferred"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "line_start",
                "line_end",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "composition_type",
          "parent_id",
          "source_status",
          "source_refs"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_id": {
            "type": "string",
            "minLength": 1
          },
          "to_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "line_start",
                "line_end",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "from_id",
          "to_id",
          "relation",
          "source_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "components",
    "relations"
  ],
  "additionalProperties": false
}
