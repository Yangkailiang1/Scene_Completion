{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "test_case_id": {
            "type": "string",
            "minLength": 1
          },
          "case_group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "confirmed",
              "pending",
              "unmatched"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "line_start",
                "line_end",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "test_case_id",
          "case_group_id",
          "status",
          "basis",
          "source_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "matches"
  ],
  "additionalProperties": false
}
