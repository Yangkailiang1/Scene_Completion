{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source_role": {
      "enum": [
        "artifact",
        "RR",
        "SR",
        "test",
        "unknown"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "enum": [
              "components",
              "api-map",
              "api-parameters",
              "rr-ssd",
              "sr-ssd",
              "fused-ssd",
              "object-operations",
              "business-entities"
            ]
          },
          "case_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverage": {
            "enum": [
              "complete",
              "partial"
            ]
          },
          "payload": {
            "type": "object"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "type": "object",
                  "properties": {
                    "document": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "role": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "start_line": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "end_line": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "quote": {
                      "type": "string"
                    },
                    "match": {
                      "enum": [
                        "exact",
                        "located",
                        "pending"
                      ]
                    },
                    "declared_line": {
                      "type": "string"
                    },
                    "document_id": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "alternatives": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    "sheet": {
                      "type": "string"
                    },
                    "json_pointer": {
                      "type": "string"
                    },
                    "cell_quote": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "match"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "match": {
                            "enum": [
                              "exact",
                              "located"
                            ]
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "document",
                          "start_line",
                          "end_line",
                          "quote"
                        ],
                        "properties": {
                          "document": {
                            "type": "string",
                            "minLength": 1
                          },
                          "start_line": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "end_line": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "required": [
                "source_id",
                "line_start",
                "line_end",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "task",
          "case_hint",
          "coverage",
          "payload",
          "source_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source_role",
    "artifacts"
  ],
  "additionalProperties": false
}
