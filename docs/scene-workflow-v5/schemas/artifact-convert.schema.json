{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "source_role": {
      "enum": [
        "artifact",
        "RR",
        "SR",
        "test",
        "unknown"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "enum": [
              "components",
              "api-map",
              "api-parameters",
              "rr-ssd",
              "sr-ssd",
              "fused-ssd",
              "object-operations"
            ]
          },
          "case_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "coverage": {
            "enum": [
              "complete",
              "partial"
            ]
          },
          "payload": {
            "type": "object"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "line_start",
                "line_end",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "task",
          "case_hint",
          "coverage",
          "payload",
          "source_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "source_role",
    "artifacts"
  ],
  "additionalProperties": false
}
