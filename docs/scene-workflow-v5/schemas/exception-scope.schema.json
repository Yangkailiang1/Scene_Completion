{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": [
              "interaction",
              "global",
              "pending"
            ]
          },
          "global_kind": {
            "enum": [
              null,
              "sequence",
              "dependency_consistency",
              "cascade",
              "idempotency"
            ]
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "related_cases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "trigger",
          "scope",
          "global_kind",
          "entity_ids",
          "related_cases",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "units"
  ],
  "additionalProperties": false
}