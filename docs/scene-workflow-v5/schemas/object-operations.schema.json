{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "supported_operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line_start": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "line_end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source_id",
                      "line_start",
                      "line_end",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "source_refs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "supported_operations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "objects"
  ],
  "additionalProperties": false
}
