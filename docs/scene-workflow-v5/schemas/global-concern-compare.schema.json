{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "G_count": {
      "type": "integer"
    },
    "E_count": {
      "type": "integer"
    },
    "M_count": {
      "type": "integer"
    },
    "M_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "line_start",
                "line_end",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "object",
          "reason",
          "source_refs"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object"
    }
  },
  "required": [
    "rows",
    "G_count",
    "E_count",
    "M_count",
    "M_ids",
    "pending",
    "metrics"
  ],
  "additionalProperties": false
}
