{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "attributes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "data_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "required": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "operation": {
                  "enum": [
                    "create",
                    "read",
                    "update",
                    "delete",
                    "any"
                  ]
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "enum": [
                          "type",
                          "enum",
                          "minimum",
                          "maximum",
                          "format",
                          "length",
                          "size",
                          "pattern",
                          "other"
                        ]
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          },
                          {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "number"
                                }
                              ]
                            }
                          }
                        ]
                      },
                      "status": {
                        "enum": [
                          "explicit",
                          "pending"
                        ]
                      },
                      "source_refs": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "source_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "line_start": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "line_end": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "source_id",
                            "line_start",
                            "line_end",
                            "quote"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "value",
                      "status",
                      "source_refs"
                    ],
                    "additionalProperties": false
                  }
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line_start": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "line_end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source_id",
                      "line_start",
                      "line_end",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "data_type",
                "required",
                "operation",
                "constraints",
                "source_refs"
              ],
              "additionalProperties": false
            }
          },
          "business_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "operation": {
                  "enum": [
                    "create",
                    "read",
                    "update",
                    "delete",
                    "any"
                  ]
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "condition": {
                  "type": "string",
                  "minLength": 1
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line_start": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "line_end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source_id",
                      "line_start",
                      "line_end",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "description",
                "operation",
                "fields",
                "condition",
                "source_refs"
              ],
              "additionalProperties": false
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "line_start": {
                  "type": "integer",
                  "minimum": 1
                },
                "line_end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "line_start",
                "line_end",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "attributes",
          "business_rules",
          "source_refs"
        ],
        "additionalProperties": false
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
