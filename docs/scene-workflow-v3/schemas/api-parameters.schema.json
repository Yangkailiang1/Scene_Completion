{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "location": {
                  "enum": [
                    "header",
                    "path",
                    "query",
                    "body",
                    "response",
                    "business"
                  ]
                },
                "data_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "required": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "default": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          }
                        ]
                      }
                    }
                  ]
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "enum": [
                          "type",
                          "enum",
                          "minimum",
                          "maximum",
                          "format",
                          "length",
                          "size",
                          "pattern",
                          "other"
                        ]
                      },
                      "value": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          },
                          {
                            "type": "array",
                            "items": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "number"
                                }
                              ]
                            }
                          }
                        ]
                      },
                      "status": {
                        "enum": [
                          "explicit",
                          "pending"
                        ]
                      },
                      "source_refs": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "source_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "line_start": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "line_end": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "source_id",
                            "line_start",
                            "line_end",
                            "quote"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "value",
                      "status",
                      "source_refs"
                    ],
                    "additionalProperties": false
                  }
                },
                "source_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "line_start": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "line_end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source_id",
                      "line_start",
                      "line_end",
                      "quote"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "name",
                "location",
                "data_type",
                "required",
                "default",
                "constraints",
                "source_refs"
