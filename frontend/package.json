{
  "name": "scene-review-workbench",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/licenses.mjs && tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write src *.ts *.js *.json scripts/*.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src *.ts *.js *.json scripts/*.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.6",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "2.1.9",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.3",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.46.4",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
