{
  "agent_runtime": "openai-compatible",
  "base_url": "${SCENE_API_BASE_URL}",
  "api_key_env": "SCENE_API_KEY",
  "agent_model": "${SCENE_AGENT_MODEL}",
  "structured_output": "json_object",
  "thinking": false,
  "timeout_seconds": 180,
  "max_retries": 0,
  "max_tokens": 16000,
  "max_concurrency": 2,
  "adaptive_concurrency": true,
  "stage_max_tokens": {"ppt-gap-compare": 16000}
}
