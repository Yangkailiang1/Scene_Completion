{
  "agent_runtime": "openai-compatible",
  "base_url": "${SCENE_SUPERVISOR_BASE_URL}",
  "api_key_env": "SCENE_SUPERVISOR_API_KEY",
  "agent_model": "${SCENE_SUPERVISOR_MODEL}",
  "thinking": false,
