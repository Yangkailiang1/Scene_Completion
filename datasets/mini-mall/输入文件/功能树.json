                    "rule": "格式 ^M[0-9]{3}$",
                    "error": null
                  },
                  {
                    "rule": "商品仅可由同一merchantId的商家访问",
                    "error": null
                  }
                ]
              },
              {
                "name": "name",
                "type": "string",
                "tags": [
                  "必填"
                ],
                "constraints": [
                  {
                    "rule": "长度 1-50",
                    "error": null
                  },
                  {
                    "rule": "同一merchantId下name不可重名；不同商家可重名",
