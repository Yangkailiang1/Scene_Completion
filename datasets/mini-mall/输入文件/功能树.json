                ]
              },
              {
                "name": "price",
                "type": "number",
                "tags": [
                  "必填"
                ],
                "constraints": [
                  {
                    "rule": "0 <= price <= 10000",
                    "error": null
                  },
                  {
                    "rule": "productType为SERVICE时price必须大于等于1",
                    "error": null
                  }
                ]
              },
              {
                "name": "status",
                "type": "string",
                "tags": [
                  "存储必填"
                ],
                "constraints": [
                  {
                    "rule": "枚举 {DRAFT|PUBLISHED}",
                    "error": null
                  },
                  {
                    "rule": "创建后为DRAFT；仅UC-005可由DRAFT改为PUBLISHED；仅DRAFT可更新或删除",
                    "error": null
                  }
                ]
              },
              {
                "name": "version",
                "type": "integer",
                "tags": [
                  "存储必填"
                ],
                "constraints": [
                  {
                    "rule": "version >= 1",
                    "error": null
                  },
                  {
                    "rule": "创建后为1；有效更新或发布成功增加1；重复幂等请求不增加",
                    "error": null
                  }
                ]
              }
            ]
          }
        ],
        "commands": [
          {
            "apiId": "API-SR-01",
