    {
      "ucId": "UC-001",
      "name": "创建商品",
      "rrLayer": {
        "entities": [
          {
            "name": "Product",
            "zh": "商品",
            "source": "功能设计_spec.md:L27 - Product.productId（持久化实体属性，不是通用请求体定义）：类型 string；存储必有；格式 ^P[0-9]{4}$；唯一标识，由数据库服务生成；创建请求不传此字段"
          }
        ],
        "commands": [
          {
            "method": "POST",
            "path": "/v1/products",
            "apiId": "API-RR-01",
            "name": "创建商品",
            "source": "RR:API-RR-01",
            "attributes": [
              "Authorization",
              "name",
              "productType",
              "price"
            ]
          },
          {
            "method": "POST",
            "path": "/ms/v1/products",
            "apiId": "API-SR-01",
            "name": "创建商品",
            "source": "SR:API-SR-01",
            "attributes": [
              "x-service-id",
              "x-merchant-id",
              "name",
              "productType",
              "price"
            ]
          }
        ]
      },
      "srLayer": {
        "entities": [
          {
            "entity": "Product",
            "attributes": [
              {
                "name": "productId",
                "type": "string",
                "tags": [
                  "存储必填"
                ],
                "constraints": [
                  {
                    "rule": "格式 ^P[0-9]{4}$",
                    "error": null
                  },
                  {
                    "rule": "唯一标识，由数据库服务生成；创建请求不传此字段",
                    "error": null
                  }
