                ]
              },
              {
                "name": "productType",
                "type": "string",
                "tags": [
                  "必填"
                ],
                "constraints": [
                  {
                    "rule": "枚举 {STANDARD|SERVICE}",
                    "error": null
                  },
                  {
                    "rule": "创建后不可修改；更新时若提供相同值则允许，提供不同值则拒绝",
                    "error": null
